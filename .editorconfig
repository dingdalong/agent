# https://editorconfig.org/
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.yaml]
indent_style = space
indent_size = 2

[makefile|Makefile]
indent_style = tab
indent_size = 4

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
charset = utf-8-bom
