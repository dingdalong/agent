Screen {
    layout: vertical;
    background: #101315;
    color: #d8dee4;
}

Screen > .screen--selection {
    background: #2f6f68;
    color: #ffffff;
}

#history {
    height: 1fr;
    padding: 0 2;
    background: #101315;
    scrollbar-color: #53616c;
    scrollbar-color-hover: #7a8b97;
    scrollbar-color-active: #2f9f91;
}

#history Markdown {
    margin-bottom: 1;
}

.history-static {
    height: auto;
}

.user-message {
    height: auto;
    margin-top: 1;
    color: #76d7c4;
}

.stream-label {
    height: auto;
    margin-top: 1;
    color: #76d7c4;
    text-style: bold;
}

.thinking-output {
    color: #8d989f;
}

MarkdownFence {
    background: #1a2025;
    color: #e5e9ec;
}

#transient-zone {
    height: auto;
    max-height: 16;
    background: #14191c;
}

#activity {
    display: none;
    height: auto;
    max-height: 10;
    padding: 1 2 0 2;
    color: #76d7c4;
}

#transcript-zone {
    display: none;
    height: 14;
    border-top: solid #3b464f;
    background: #14191c;
}

#transcript-header {
    height: auto;
    min-height: 2;
    padding: 0 2;
    color: #d8dee4;
    text-style: bold;
    border-bottom: solid #3b464f;
}

#transcript-panel {
    height: 1fr;
    padding: 0 2;
    scrollbar-size: 1 1;
    scrollbar-color: #53616c;
}

#completion {
    display: none;
    height: auto;
    max-height: 8;
    padding: 0 2;
    color: #c9d1d7;
    background: #1a2025;
}

.separator {
    height: 1;
    color: #53616c;
}

#composer-shell {
    height: 1;
    min-height: 1;
    max-height: 8;
    padding: 0 1;
    background: #171c20;
}

#input {
    height: 1fr;
    border: none;
    background: #171c20;
    color: #f0f3f5;
    scrollbar-size: 1 1;
}

#input .text-area--selection, #dialog-input .text-area--selection {
    background: #2f6f68;
    color: #ffffff;
}

#core-status {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 2;
    background: #23292e;
    color: #aeb8bf;
}

#agent-list {
    height: auto;
    max-height: 10;
    background: #151a1e;
    scrollbar-size: 1 1;
}

#agent-list ListItem {
    height: 1;
    padding: 0 2;
    color: #aeb8bf;
}

#agent-list ListItem.--highlight {
    background: #2f6f68;
    color: #ffffff;
}

.viewing #composer-shell, .viewing #separator-top,
.viewing #separator-bottom, .viewing #agent-list,
.dialog-open #agent-list {
    display: none;
}

.compact #history, .compact #activity, .compact #transcript-panel,
.compact #transcript-header, .compact #completion, .compact #core-status,
.compact #agent-list ListItem {
    padding-left: 1;
    padding-right: 1;
}

.short #transient-zone {
    max-height: 10;
}

.short #transcript-zone {
    height: 8;
}

.short #agent-list {
    max-height: 4;
}

.short #form-split {
    max-height: 14;
}

.short #form-preview-pane {
    max-height: 14;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.62);
}

#dialog-shell {
    width: 88%;
    min-width: 42;
    max-width: 96;
    height: auto;
    max-height: 88%;
    padding: 0 2;
    border: solid #6a7a84;
    background: #171c20;
    color: #d8dee4;
}

.dialog-title {
    height: auto;
    color: #efc36a;
    text-style: bold;
}

.dialog-source, .dialog-hint {
    height: auto;
    color: #8d989f;
}

.dialog-prompt, .dialog-detail {
    height: auto;
    margin: 1 0;
}

#dialog-options {
    height: auto;
    max-height: 12;
    border: none;
    background: #171c20;
}

#choice-input-options {
    height: auto;
    margin-bottom: 1;
}

#form-tabs, #form-body {
    height: auto;
}

#form-hint {
    height: auto;
    margin-top: 1;
}

#form-tabs {
    color: #76d7c4;
    text-style: bold;
    margin-top: 1;
}

#form-question-text {
    height: auto;
    color: #d8dee4;
    margin-top: 1;
}

#form-body {
    min-height: 3;
}

/* --- 选项预览分栏布局 --- */

#form-split {
    height: auto;
    min-height: 5;
    max-height: 24;
    margin-top: 1;
}

#form-left {
    width: auto;
    min-width: 24;
    height: auto;
}

#form-preview-pane {
    width: 1fr;
    min-width: 20;
    height: auto;
    min-height: 3;
    max-height: 24;
    border-left: solid #3b464f;
    padding: 0 1;
    background: #101315;
    scrollbar-size: 1 1;
    scrollbar-color: #53616c;
    scrollbar-color-hover: #7a8b97;
}

#form-preview {
    height: auto;
    margin: 0;
}

.dialog-form-preview {
    max-width: 140;
}

.compact .dialog-form-preview {
    max-width: 96;
}

.compact #form-split {
    layout: vertical;
}

.compact #form-left {
    width: 100%;
}

.compact #form-preview-pane {
    width: 100%;
    max-height: 10;
    border-left: none;
    border-top: solid #3b464f;
    margin-top: 1;
}

#dialog-input {
    height: 4;
    border: solid #3b464f;
    background: #101315;
    color: #f0f3f5;
}

.compact #dialog-shell {
    width: 96%;
    min-width: 20;
    padding: 0 1;
}
