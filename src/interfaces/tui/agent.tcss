Screen {
    layout: vertical;
    background: ansi_default;
    color: #d8dee4;
}

Screen > .screen--selection {
    background: #2f6f68;
    color: #ffffff;
}

#history {
    height: 1fr;
    padding: 0 2;
    background: ansi_default;
    scrollbar-size: 0 0;
}

#interaction-slot {
    display: none;
    height: auto;
    max-height: 24;
    background: ansi_default;
}

MarkdownFence {
    background: ansi_default;
    color: #e5e9ec;
}

#transient-zone {
    height: auto;
    max-height: 16;
    background: ansi_default;
}

#activity {
    display: none;
    height: auto;
    max-height: 10;
    padding: 1 2 0 2;
    color: #76d7c4;
}

#transcript-zone {
    display: none;
    height: 14;
    border-top: solid #3b464f;
    background: ansi_default;
}

#transcript-header {
    height: auto;
    min-height: 2;
    padding: 0 2;
    color: #d8dee4;
    text-style: bold;
    border-bottom: solid #3b464f;
}

#transcript-panel {
    height: 1fr;
    padding: 0 2;
    scrollbar-size: 1 1;
    scrollbar-color: #53616c;
}

#completion {
    display: none;
    height: auto;
    max-height: 8;
    padding: 0 2;
    color: #c9d1d7;
    background: ansi_default;
}

.separator {
    height: 1;
    color: #53616c;
}

/* 输入框上方的状态行：常驻占位一行，右对齐，暗灰次要文字 */
#input-status {
    height: 1;
    padding: 0 2;
    text-align: right;
    background: ansi_default;
    color: #8d989f;
}

#composer-shell {
    height: 1;
    min-height: 1;
    max-height: 8;
    padding: 0 1;
    background: ansi_default;
}

#input {
    height: 1fr;
    border: none;
    background: ansi_default;
    color: #f0f3f5;
    scrollbar-size: 0 0;
}

#input .text-area--selection, #dialog-input .text-area--selection {
    background: #2f6f68;
    color: #ffffff;
}

/* 光标所在行不高亮，避免输入后输入栏局部变色 */
#input .text-area--cursor-line, #dialog-input .text-area--cursor-line {
    background: transparent;
}

/* 光标：不透明白底 + 深色字，去掉 :ansi 分支注入的 reverse 反显，确保清晰可见 */
#input .text-area--cursor, #dialog-input .text-area--cursor {
    color: #000000;
    background: #ffffff;
    text-style: none;
}

#core-status {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 2;
    background: ansi_default;
    color: #aeb8bf;
}

#agent-list {
    height: auto;
    max-height: 10;
    background: ansi_default;
    scrollbar-size: 1 1;
}

#agent-list ListItem {
    height: 1;
    padding: 0 2;
    color: #aeb8bf;
}

#agent-list ListItem.--highlight {
    background: #2f6f68;
    color: #ffffff;
}

.viewing #composer-shell, .viewing #separator-top,
.viewing #separator-bottom, .viewing #input-status,
.viewing #agent-list, .dialog-open #agent-list {
    display: none;
}

.compact #history, .compact #activity, .compact #transcript-panel,
.compact #transcript-header, .compact #completion, .compact #core-status,
.compact #input-status, .compact #agent-list ListItem {
    padding-left: 1;
    padding-right: 1;
}

.short #transient-zone {
    max-height: 10;
}

.short #interaction-slot {
    max-height: 14;
}

.short #transcript-zone {
    height: 8;
}

.short #agent-list {
    max-height: 4;
}

.short #form-split {
    max-height: 14;
}

.short #form-preview-pane {
    max-height: 14;
}

.short #model-menu-scroll {
    max-height: 5;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.62);
}

#dialog-shell {
    width: 88%;
    min-width: 42;
    max-width: 96;
    height: auto;
    max-height: 88%;
    padding: 0 2;
    border: solid #6a7a84;
    background: ansi_default;
    color: #d8dee4;
}

.dialog-title {
    height: auto;
    color: #efc36a;
    text-style: bold;
}

.dialog-source, .dialog-hint {
    height: auto;
    color: #8d989f;
}

.dialog-prompt, .dialog-detail {
    height: auto;
    margin: 1 0;
}

#model-menu-scroll {
    height: auto;
    min-height: 3;
    max-height: 8;
    scrollbar-size: 1 1;
    scrollbar-color: #53616c;
    scrollbar-color-hover: #7a8b97;
}

#model-menu-body {
    height: auto;
}

#model-menu-effort {
    height: auto;
    color: #d8dee4;
}

#dialog-options {
    height: auto;
    max-height: 12;
    border: none;
    background: ansi_default;
}

#choice-input-options {
    height: auto;
    margin-bottom: 1;
}

#form-tabs, #form-body {
    height: auto;
}

#form-hint {
    height: auto;
    color: #8d989f;
}

#form-tabs {
    color: #76d7c4;
    text-style: bold;
    margin-top: 1;
}

#form-question-text {
    height: auto;
    color: #d8dee4;
    margin-top: 1;
}

#form-body {
    min-height: 3;
}

/* --- 选项预览分栏布局 --- */

#form-split {
    height: auto;
    min-height: 5;
    max-height: 24;
    margin-top: 1;
}

#form-left {
    width: auto;
    min-width: 24;
    height: auto;
}

#form-preview-pane {
    width: 1fr;
    min-width: 20;
    height: auto;
    min-height: 3;
    max-height: 24;
    border-left: solid #3b464f;
    padding: 0 1;
    background: ansi_default;
    scrollbar-size: 1 1;
    scrollbar-color: #53616c;
    scrollbar-color-hover: #7a8b97;
}

#form-preview {
    height: auto;
    margin: 0;
}

.dialog-form-preview {
    max-width: 140;
}

.compact .dialog-form-preview {
    max-width: 96;
}

.compact #form-split {
    layout: vertical;
}

.compact #form-left {
    width: 100%;
}

.compact #form-preview-pane {
    width: 100%;
    max-height: 10;
    border-left: none;
    border-top: solid #3b464f;
    margin-top: 1;
}

#dialog-input {
    height: 4;
    border: solid #3b464f;
    background: ansi_default;
    color: #f0f3f5;
}

.compact #dialog-shell {
    width: 96%;
    min-width: 20;
    padding: 0 1;
}

/* --- 内嵌交互 Widget（替代弹窗） --- */

.inline-widget {
    height: auto;
    width: 100%;
    margin: 1 0;
    padding: 0;
}

/* 内嵌模式：无边框、无独立背景，融入聊天流；左侧竖线标记交互区块 */
.inline-widget #dialog-shell {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    max-height: 100%;
    border: none;
    background: ansi_default;
    padding: 0;
    border-left: solid #6a7a84;
    padding-left: 1;
}

.inline-widget .dialog-title {
    color: #efc36a;
    text-style: bold;
}

.inline-widget .dialog-source,
.inline-widget .dialog-hint {
    color: #8d989f;
}

.inline-widget .dialog-prompt,
.inline-widget .dialog-detail {
    margin: 0;
    color: #d8dee4;
}

.inline-widget #dialog-options {
    border: none;
    background: ansi_default;
}

.inline-widget #dialog-input {
    height: 4;
    border: solid #3b464f;
    background: ansi_default;
    color: #f0f3f5;
}

.inline-widget #form-tabs {
    color: #76d7c4;
    text-style: bold;
}

.inline-widget #form-preview-pane {
    border-left: solid #3b464f;
    background: ansi_default;
}

.inline-widget-active #agent-list {
    display: none;
}
